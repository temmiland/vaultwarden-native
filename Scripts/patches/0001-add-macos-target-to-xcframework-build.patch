diff --git a/crates/bitwarden-uniffi/swift/build.sh b/crates/bitwarden-uniffi/swift/build.sh
index 3a189328..74c9f0f6 100755
--- a/crates/bitwarden-uniffi/swift/build.sh
+++ b/crates/bitwarden-uniffi/swift/build.sh
@@ -22,11 +22,13 @@ else
 fi
 echo "$PROFILE_FLAG"
 # One invocation for all targets, so Cargo can build them in parallel.
-cargo build --package bitwarden-uniffi \
-  --target aarch64-apple-ios-sim \
-  --target aarch64-apple-ios \
-  --target x86_64-apple-ios \
-  $PROFILE_FLAG
+TARGET_ARGS=(--target aarch64-apple-ios-sim --target aarch64-apple-ios --target x86_64-apple-ios)
+if [[ "${BUILD_MACOS:-false}" = "true" ]]; then
+  export MACOSX_DEPLOYMENT_TARGET="14.0"
+  TARGET_ARGS+=(--target aarch64-apple-darwin --target x86_64-apple-darwin)
+fi
+# Preserve upstream's application-extension and non-commercial dependency guards on every target.
+cargo build --locked --package bitwarden-uniffi "${TARGET_ARGS[@]}" $PROFILE_FLAG
 
 mkdir -p tmp/target/universal-ios-sim/$PROFILE
 
@@ -35,8 +37,22 @@ lipo -create ../../../target/aarch64-apple-ios-sim/$PROFILE/libbitwarden_uniffi.
   ../../../target/x86_64-apple-ios/$PROFILE/libbitwarden_uniffi.a \
   -output ./tmp/target/universal-ios-sim/$PROFILE/libbitwarden_uniffi.a
 
+LIBRARY_ARGS=(
+  -library "../../../target/aarch64-apple-ios/$PROFILE/libbitwarden_uniffi.a" -headers ./tmp/Headers
+  -library "./tmp/target/universal-ios-sim/$PROFILE/libbitwarden_uniffi.a" -headers ./tmp/Headers
+)
+if [[ "${BUILD_MACOS:-false}" = "true" ]]; then
+  mkdir -p "tmp/target/universal-macos/$PROFILE"
+  lipo -create "../../../target/aarch64-apple-darwin/$PROFILE/libbitwarden_uniffi.a" \
+    "../../../target/x86_64-apple-darwin/$PROFILE/libbitwarden_uniffi.a" \
+    -output "./tmp/target/universal-macos/$PROFILE/libbitwarden_uniffi.a"
+  LIBRARY_ARGS+=(-library "./tmp/target/universal-macos/$PROFILE/libbitwarden_uniffi.a" -headers ./tmp/Headers)
+fi
+
 # Generate swift bindings
-cargo run -p uniffi-bindgen generate \
+# Askama template paths must use the physical Cargo registry path when CARGO_HOME is a symlink.
+export CARGO_HOME="$(cd "${CARGO_HOME:-$HOME/.cargo}" && pwd -P)"
+cargo run --locked -p uniffi-bindgen generate \
   ../../../target/aarch64-apple-ios-sim/$PROFILE/libbitwarden_uniffi.dylib \
   --language swift \
   --no-format \
@@ -52,10 +68,7 @@ cat ./tmp/bindings/*.modulemap > ./tmp/Headers/module.modulemap
 
 # Build xcframework
 xcodebuild -create-xcframework \
-  -library ../../../target/aarch64-apple-ios/$PROFILE/libbitwarden_uniffi.a \
-  -headers ./tmp/Headers \
-  -library ./tmp/target/universal-ios-sim/$PROFILE/libbitwarden_uniffi.a \
-  -headers ./tmp/Headers \
+  "${LIBRARY_ARGS[@]}" \
   -output ./BitwardenFFI.xcframework
 
 # Cleanup temporary files
